# Used by the asynchronous write path only. Never expose this key to the UI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Used only by the local short-video voice-transcript pipeline.
TIKHUB_API_KEY=
# Mainland China: https://api.tikhub.dev; elsewhere: https://api.tikhub.io
TIKHUB_BASE_URL=https://api.tikhub.dev
# OpenAI-compatible speech-to-text endpoint; uploaded audio is deleted locally after transcription.
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
