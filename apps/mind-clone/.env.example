# Used by the asynchronous write path only. Never expose this key to the UI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Formal interview answers are local-only. Ollama's native API disables Qwen thinking for low latency.
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen3:8b
LOCAL_MODEL_API_KEY=local
LOCAL_MODEL_CONTEXT_TOKENS=8192
LOCAL_MODEL_MAX_OUTPUT_TOKENS=768

# Used only by the local short-video voice-transcript pipeline.
TIKHUB_API_KEY=
# Mainland China: https://api.tikhub.dev; elsewhere: https://api.tikhub.io
TIKHUB_BASE_URL=https://api.tikhub.dev
# Local whisper.cpp model. No audio is sent to an external transcription service.
WHISPER_CLI_PATH=whisper-cli
# Relative paths are resolved from apps/mind-clone by npm workspace scripts.
WHISPER_MODEL_PATH=models/whisper/ggml-small.bin
WHISPER_THREADS=4
