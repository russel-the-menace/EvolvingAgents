# Start with Spot Testnet credentials from https://testnet.binance.vision/
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Independent server-side limits. This first version supports USDT spot pairs only.
# Use * and 0 for the maximum client-side capability boundary. Binance filters,
# balance checks, rate limits, and exchange-side permissions still apply.
BINANCE_SYMBOLS=*
MAX_ORDER_USDT=0

# Optional. Without a model gateway, explicit Chinese/English market commands still work.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_PROVIDER=openai
GATEWAY_MODEL=gpt-5.6-luna
GATEWAY_REASONING_EFFORT=medium

# Comma-separated RSS/Atom sources. Breaking items are pushed immediately;
# normal items are grouped into two-hour digests.
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://techflowpost.substack.com/feed
# CEX announcement feeds. Kraken is official RSS; the other defaults use RSSHub bridges
# because Binance/OKX/Bybit do not publish a stable documented RSS/API feed.
NEWS_CEX_RSS_URLS=https://rsshub.app/binance/announcement,https://rsshub.app/okx/announcement,https://rsshub.app/bybit/announcement,https://blog.kraken.com/feed
NEWS_POLL_MS=300000
NEWS_STATE_FILE=
# Public aggregator: cryptocurrency.cv exposes 200+ crypto/financial sources.
# Set NEWS_EXTERNAL_SOURCES=off to disable it.
NEWS_EXTERNAL_SOURCES=on
CRYPTO_NEWS_URL=https://cryptocurrency.cv/api/news?limit=30
# Optional 6551 OpenNews/OpenTwitter connector. Never reuse Binance credentials.
OPENNEWS_TOKEN=
NEWS_SOCIAL_KEYWORDS=BTC,Bitcoin,Ethereum
# Optional. SQLite knowledge memory for deduplicated, time-scoped news claims.
NEWS_LEARNING_DB_FILE=

# Live mode requires BINANCE_ENV=live and this second explicit unlock.
# Never enable withdrawals on this API key. Restrict it by IP.
BINANCE_LIVE_TRADING=false
