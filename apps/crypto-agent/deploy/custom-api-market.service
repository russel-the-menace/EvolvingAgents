[Unit]
Description=CryptoAgent Coin-M market relay
Requires=mihomo.service
After=network-online.target mihomo.service

[Service]
Type=simple
WorkingDirectory=/opt/custom-api-gateway
EnvironmentFile=/opt/custom-api-gateway/.env.local
Environment=PYTHONPATH=/opt/custom-api-gateway/market_deps
Environment=MARKET_FEATURE_DB_PATH=/var/lib/custom-api-gateway/market-features.sqlite
ExecStart=/usr/bin/python3 /opt/custom-api-gateway/market_relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
