[Unit]
Description=CryptoAgent news collector
Requires=mihomo.service
After=network-online.target mihomo.service custom-api-gateway.service

[Service]
Type=simple
WorkingDirectory=/opt/custom-api-gateway
EnvironmentFile=/opt/custom-api-gateway/.env.local
ExecStart=/usr/bin/python3 /opt/custom-api-gateway/news_collector.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
